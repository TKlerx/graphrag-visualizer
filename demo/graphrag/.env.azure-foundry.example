# Copy to your GraphRAG project root as .env and fill from OpenTofu outputs.

GRAPHRAG_API_KEY=<azure-ai-foundry-or-azure-openai-key>
GRAPHRAG_API_BASE=<foundry_endpoint>
GRAPHRAG_API_VERSION=2024-10-21

GRAPHRAG_CHAT_DEPLOYMENT=gpt-5.4
GRAPHRAG_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Use azure_managed_identity in settings.azure-foundry.yml if running inside Azure with identity.
GRAPHRAG_AUTH_METHOD=api_key
